# â”€â”€â”€ MongoDB Atlas â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get yours from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/card-max?retryWrites=true&w=majority

# â”€â”€â”€ Vercel ISR Revalidation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# A random secret used to protect the /api/revalidate endpoint.
# Generate one with: openssl rand -base64 32
# Must also be added as a GitHub Actions secret AND a Vercel env var.
VERCEL_REVALIDATION_SECRET=change-me-to-a-random-32-char-secret

# â”€â”€â”€ App URL (used by crawler to call the revalidation endpoint) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set to your production Vercel URL (no trailing slash)
VERCEL_APP_URL=https://card-max.vercel.app

# â”€â”€â”€ Brandfetch Logo API (secondary fallback for merchant logos) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Free tier: 50 calls/month. Get your key at https://brandfetch.com
# Also add as a GitHub Actions secret: BRANDFETCH_API_KEY
BRANDFETCH_API_KEY=your-brandfetch-api-key-here

# â”€â”€â”€ Upstash Redis (API Rate Limiting) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required in production. Omit in local dev to skip rate limiting (fail open).
# Sign up at https://upstash.com â€” create a Redis database, copy REST URL + token.
# Each rate limit check = 2 Redis commands. Free tier: 10,000 commands/day.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXXxxxxxxxx

# â”€â”€â”€ Admin Dashboard (Google OAuth) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# AUTH_SECRET â€” random secret for encrypting session JWTs.
# Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-char-secret

# Google OAuth credentials â€” create at https://console.cloud.google.com
# Authorized redirect URI: https://card-max.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# The single Google email allowed to access /admin
ADMIN_EMAIL=chamisenarath@gmail.com

# GITHUB_FEEDBACK_TOKEN â€” PAT with issues:write scope for creating GitHub issues
# from user feedback. Create at: https://github.com/settings/tokens
GITHUB_FEEDBACK_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_REPO_OWNER=chamirusenarath96
GITHUB_REPO_NAME=card-max

# â”€â”€â”€ AI Offer Enrichment (Claude) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Used by the separate enrichment workflow (crawler/enrichment/run.ts) for
# semantic-summary generation and vision-based conditions/date extraction.
# Get yours at https://console.anthropic.com
# Also add as a GitHub Actions secret: ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Optional â€” second, text-only LLM provider for enrichment (spec 057). When
# set, the enrichment router spills semantic-summary calls to Groq once
# Gemini's per-minute free-tier window is exhausted, instead of stalling.
# Omitting this is fully supported â€” Gemini-only, unchanged behavior.
# Get yours at https://console.groq.com
# Also add as a GitHub Actions secret: GROQ_API_KEY
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# --- Scraping Proxy Fallback (spec 053) ---------------------------------------
# Optional. Only used when a direct fetch fails/is blocked for combank, boc,
# or ntb (AWS WAF IP-reputation blocks GitHub Actions runners), and only as a
# legacy path when Bright Data below is not configured.
# WebScrapingAPI: https://www.webscrapingapi.com
WEBSCRAPINGAPI_API_KEY=your-webscrapingapi-api-key-here

# Optional explicit bank -> provider pinning (JSON). Banks not listed here are
# distributed deterministically across whatever providers are configured.
# Example: {"commercial_bank":"brightdata-unlocker","bank_of_ceylon":"webscrapingapi"}
PROXY_BANK_MAP={}

# --- Bright Data (spec 078) -- main scraping-proxy fetcher ---------------------
# Supersedes WebScrapingAPI above as the default provider: when either
# BRIGHTDATA_API_KEY or the Residential vars below are set, the legacy
# WEBSCRAPINGAPI_API_KEY var is ignored (see registry.ts).
#
# Web Unlocker API (primary) — handles anti-bot/CAPTCHA/fingerprinting for
# you. In the Bright Data dashboard: Web Access -> Create API -> Web Unlocker
# API -> name it (this name is BRIGHTDATA_ZONE below, the API's internal
# "zone" identifier) -> Finish creation. Web Unlocker has no dashboard-level
# "restrict to country" zone setting — the Sri Lanka lock is enforced purely
# per-request via the "country":"lk" field this code already sends on every
# call (see brightDataUnlocker.ts), plus the geo.brdtest.com verification.
BRIGHTDATA_API_KEY=your-brightdata-api-key-here
BRIGHTDATA_ZONE=your-web-unlocker-api-name

# Residential proxy (optional, cheaper — for "easy" sites only; does not fix
# TLS fingerprinting, so don't rely on it for sites that fingerprint-check).
# Unlike Web Unlocker, Residential/Mobile zones DO have a dashboard
# "Geolocation targeting" option on the zone's own config page — set it to
# Sri Lanka there too, in addition to the per-request "-country-lk" flag
# this code already sends.
BRIGHTDATA_RESIDENTIAL_CUSTOMER_ID=your-brightdata-customer-id
BRIGHTDATA_RESIDENTIAL_ZONE=your-residential-zone-name
BRIGHTDATA_RESIDENTIAL_PASSWORD=your-residential-zone-password

# Pin specific banks to Residential instead of the Unlocker default, via the
# existing PROXY_BANK_MAP, e.g.: {"peoples_bank":"brightdata-residential"}

# â”€â”€â”€ Google AdSense â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set NEXT_PUBLIC_ADSENSE_ENABLED=true to activate ad units.
# Keep false (or unset) in dev/test to prevent accidental ad loading.
# Apply for AdSense at https://www.google.com/adsense before enabling.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_GRID=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_DRAWER=XXXXXXXXXX

