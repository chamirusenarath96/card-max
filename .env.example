# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get yours from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/card-max?retryWrites=true&w=majority

# ─── Vercel ISR Revalidation ──────────────────────────────────────────────────
# A random secret used to protect the /api/revalidate endpoint.
# Generate one with: openssl rand -base64 32
# Must also be added as a GitHub Actions secret AND a Vercel env var.
VERCEL_REVALIDATION_SECRET=change-me-to-a-random-32-char-secret

# ─── App URL (used by crawler to call the revalidation endpoint) ──────────────
# Set to your production Vercel URL (no trailing slash)
VERCEL_APP_URL=https://card-max.vercel.app

# ─── Brandfetch Logo API (secondary fallback for merchant logos) ──────────────
# Free tier: 50 calls/month. Get your key at https://brandfetch.com
# Also add as a GitHub Actions secret: BRANDFETCH_API_KEY
BRANDFETCH_API_KEY=your-brandfetch-api-key-here

# ─── Upstash Redis (API Rate Limiting) ───────────────────────────────────────
# Required in production. Omit in local dev to skip rate limiting (fail open).
# Sign up at https://upstash.com — create a Redis database, copy REST URL + token.
# Each rate limit check = 2 Redis commands. Free tier: 10,000 commands/day.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXXxxxxxxxx

# ─── Admin Dashboard (Google OAuth) ──────────────────────────────────────────
# AUTH_SECRET — random secret for encrypting session JWTs.
# Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-char-secret

# Google OAuth credentials — create at https://console.cloud.google.com
# Authorized redirect URI: https://card-max.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# The single Google email allowed to access /admin
ADMIN_EMAIL=chamisenarath@gmail.com

# GITHUB_FEEDBACK_TOKEN — PAT with issues:write scope for creating GitHub issues
# from user feedback. Create at: https://github.com/settings/tokens
GITHUB_FEEDBACK_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_REPO_OWNER=chamirusenarath96
GITHUB_REPO_NAME=card-max

# ─── AI Offer Enrichment (Claude) ────────────────────────────────────────────
# Used by the separate enrichment workflow (crawler/enrichment/run.ts) for
# semantic-summary generation and vision-based conditions/date extraction.
# Get yours at https://console.anthropic.com
# Also add as a GitHub Actions secret: ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Scraping Proxy Fallback (spec 053) ──────────────────────────────────────
# All three are optional. Only used when a direct fetch fails/is blocked for
# combank, boc, or ntb (AWS WAF IP-reputation blocks GitHub Actions runners).
# Free-tier, recurring-monthly-credit providers — configure either or both.
# ZenRows: https://www.zenrows.com | WebScrapingAPI: https://www.webscrapingapi.com
ZENROWS_API_KEY=your-zenrows-api-key-here
WEBSCRAPINGAPI_API_KEY=your-webscrapingapi-api-key-here

# Optional explicit bank → provider pinning (JSON). Banks not listed here are
# distributed deterministically across whatever providers are configured.
# Example: {"commercial_bank":"zenrows","bank_of_ceylon":"webscrapingapi"}
PROXY_BANK_MAP={}

# ─── Google AdSense ───────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_ADSENSE_ENABLED=true to activate ad units.
# Keep false (or unset) in dev/test to prevent accidental ad loading.
# Apply for AdSense at https://www.google.com/adsense before enabling.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_GRID=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_DRAWER=XXXXXXXXXX
